#!/bin/sh
set -e                           # abort on first failure — no partial commits

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo "✗ direct commits to main are blocked — create a feature branch first:"
  echo "  git checkout -b <type>/description"
  exit 1
fi

npm run check                    # biome: lint + auto-fix formatting in src/, test/, harness/
npm run --if-present format:md   # prettier: auto-fix markdown (skipped if script absent)
git add -u                       # re-stage files changed by the auto-fixers above
npm run typecheck                # tsc --noEmit: fail if types don't compile
npm run --if-present typecheck:harness   # checkJs pass over harness/ (skipped if script absent)
